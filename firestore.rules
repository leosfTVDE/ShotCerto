rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Cada pessoa só vê e altera os próprios dados.
    match /users/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
      match /analises/{id} {
        allow read, write: if request.auth != null && request.auth.uid == uid;
      }
    }
  }
}
